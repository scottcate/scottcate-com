---
import { SOCIAL } from '../consts';

interface Props {
  /** "full" shows handles beside the icons; "icons" is compact. */
  variant?: 'full' | 'icons';
}
const { variant = 'full' } = Astro.props;
---

<ul class:list={['contact-links', variant]}>
  <li>
    <a href={SOCIAL.x.url} rel="me noopener" target="_blank" aria-label={`Scott Cate on X (${SOCIAL.x.handle})`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
        ></path>
      </svg>
      {variant === 'full' && <span>{SOCIAL.x.handle} on X</span>}
    </a>
  </li>
  <li>
    <a href={SOCIAL.linkedin.url} rel="me noopener" target="_blank" aria-label="Scott Cate on LinkedIn">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          fill="currentColor"
          d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"
        ></path>
      </svg>
      {variant === 'full' && <span>LinkedIn {SOCIAL.linkedin.handle}</span>}
    </a>
  </li>
</ul>
