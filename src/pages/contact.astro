---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
---

<BaseLayout title="Contact" description="Get in touch with Scott Cate on X (@scottcate) or LinkedIn.">
  <article class="wrap-narrow page">
    <h1>Contact</h1>
    <div class="prose">
      <p><strong>Thank you for your interest in my blog and VSTricks.</strong></p>
      <p>
        Do you have a Visual Studio tip or trick? A question or comment about something I wrote? Let me know what you
        think — tell me a story 🙂
      </p>
      <p>The best way to reach me is a message on X or LinkedIn:</p>
    </div>
    <ContactLinks />
  </article>
</BaseLayout>
