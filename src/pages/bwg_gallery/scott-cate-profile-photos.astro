---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfilePhotos from '../../components/ProfilePhotos.astro';
import { profilePhotos } from '../../data/profile-photos';
import { PERSON_ID } from '../../data/person';
import { SITE } from '../../consts';

const [cover] = profilePhotos;
const schema = [
  {
    '@type': 'ImageGallery',
    name: 'Scott Cate Profile Photos',
    image: profilePhotos.map((photo) => ({
      '@type': 'ImageObject',
      contentUrl: new URL(photo.sizes[0].src, SITE.url).href,
      width: photo.sizes[0].width,
      height: photo.sizes[0].height,
      caption: photo.alt,
      creator: { '@id': PERSON_ID },
    })),
  },
];
---

<BaseLayout
  title="Scott Cate Profile Photos"
  description="Profile and press photos of Scott Cate."
  image={cover.sizes[0].src}
  imageAlt={cover.alt}
  schema={schema}
>
  <article class="wrap page">
    <h1>Scott Cate Profile Photos</h1>
    <p class="lede">Feel free to use these photos for event bios, articles, and introductions.</p>
    <ProfilePhotos />
  </article>
</BaseLayout>
