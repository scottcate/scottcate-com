---
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro';
import { getPosts, paginate, type Page, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  return paginate(await getPosts(), '/author/scottcate/').map(({ param, page }) => ({ params: { page: param }, props: { page } }));
}

const { page } = Astro.props as { page: Page<Post> };
---

<ArchiveLayout title="Scott Cate" eyebrow="Author" description="Husband, father, author, and technical founder." page={page} />
